# Copy this file to .env in the repository root and fill in the placeholders.
# .env is git-ignored. A process environment variable overrides the same variable
# here.

# GPUs for cuOpt, cuML, and CuPy: one index or a comma-separated list. Work inside
# one process runs on the first listed GPU, and run_on_gpus() spreads independent
# jobs over all of them; unset, GPU 0. Read by
# apply_gpu_selection() in the notebooks and by `uv run --env-file .env`, and only
# before anything imports cvxpy (see the README's GPU Selection section).
CUDA_VISIBLE_DEVICES=0

# Scenario-generator plugins may read their own settings from this file too.
