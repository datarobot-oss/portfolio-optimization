# Copy this file to .env in the repository root and fill in the placeholders.
# .env is git-ignored. A process environment variable overrides the same variable
# here.

# GPUs for cuOpt, cuML, and CuPy: one index or a comma-separated list. Work inside
# one process runs on the first listed GPU, and run_on_gpus() spreads independent
# jobs over all of them; unset, GPU 0. Read by
# apply_gpu_selection() in the notebooks and by `uv run --env-file .env`, and only
# before anything imports cvxpy (see the README's GPU Selection section).
CUDA_VISIBLE_DEVICES=0

# JointFM scenario generation (fit_type="jointfm"). Selectors from the process
# environment and this file count together.

# Request contract the jointfm-client SDK speaks; required for every selector.
JOINTFM_SCHEMA_VERSION=v6

# DataRobot credentials, required only for hosted deployments.
# DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2
# DATAROBOT_API_TOKEN=

# Set exactly one selector. See the jointfm-client README for further selectors:
# https://github.com/datarobot/joint-client-python

# 1. A JointFM instance you run yourself.
JOINTFM_LOCAL_BASE_URL=http://127.0.0.1:8080

# 2. Several instances serving the same checkpoint, for example one per GPU.
# JOINTFM_LOCAL_BASE_URLS=http://127.0.0.1:8080,http://127.0.0.1:8081

# 3. One DataRobot deployment.
# JOINTFM_DEPLOYMENT_ID=<deployment-id>

# 4. A pool of DataRobot deployments serving the same checkpoint.
# JOINTFM_DEPLOYMENT_IDS=<deployment-id-1>,<deployment-id-2>
